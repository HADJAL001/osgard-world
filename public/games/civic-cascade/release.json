        "resource-cost",
        "worst-stress-risk-delta",
        "worst-stress-weakest-integrity-delta",
        "stable-stress-profile-count"
      ],
      "portfolioLimit": 3,
      "prefersDistinctCommandPrefixes": true,
      "explainsCandidateTradeoffs": true,
      "reportsDominanceStatus": true,
      "comparesOnlyDeterministicModelOutputs": true,
      "maximizesDistinctOpeningPrefixes": true,
      "portfolioDiversity": "maximum-available-distinct-first-two-command-prefixes"
