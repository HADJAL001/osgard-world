# Never commit real credentials. Configure these in the private service environment.
NODE_ENV=production
PORT=8080
# Only when this service is reachable through the single trusted OSGARD Nginx hop.
TRUST_PROXY=true
PUBLIC_BASE_URL=https://osgard.world
ALLOWED_ORIGINS=https://osgard.world,https://www.osgard.world,http://localhost:4188
DATABASE_URL=
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Keep false until Stripe account, product terms, refunds and legal entity are verified.
ENABLE_LIVE_PAYMENTS=false
ENABLE_OSGARD_PREMIUM_SALES=false
STRIPE_PRICE_SUPPORT_OSGARD=
STRIPE_PRICE_OSGARD_PREMIUM_MONTHLY=
STRIPE_PRICE_DEVELOPMENT_DEPOSIT=
# Generate a random value with at least 32 characters; store only in secret environment.
ADMIN_API_TOKEN=
# Optional; used only by the authenticated, manually-triggered, read-only Operations Copilot.
# Never expose this secret through Vite variables, public assets, or browser code.
OPENAI_API_KEY=
OPENAI_OPS_MODEL=gpt-5-mini
# Retain consented commerce analytics for 30–365 days (default 90); expired rows are purged at startup and every 6 hours.
ANALYTICS_RETENTION_DAYS=90
# Optional: set true only when TLS is enabled and database certificate validation is configured.
DATABASE_SSL=false
