# Never commit real credentials. Configure these in the hosting provider's secret environment.
NODE_ENV=production
PORT=8080
PUBLIC_BASE_URL=https://osgard.world
ALLOWED_ORIGINS=https://osgard.world,https://www.osgard.world,http://localhost:4188
DATABASE_URL=
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Keep false until Stripe account, product terms, refunds and legal entity are verified.
ENABLE_LIVE_PAYMENTS=false
STRIPE_PRICE_SUPPORT_OSGARD=
STRIPE_PRICE_OSGARD_PREMIUM_MONTHLY=
STRIPE_PRICE_DEVELOPMENT_DEPOSIT=
# Generate a random value with at least 32 characters; store only in secret environment.
ADMIN_API_TOKEN=
# Optional: set true only when TLS is enabled and database certificate validation is configured.
DATABASE_SSL=false
